# ==========================================
# Bulk Certificate Generator - Supabase Configuration
# ==========================================

# 1. Sign in to your Supabase project (https://supabase.com/dashboard)
# 2. Go to Project Settings -> API
# 3. Copy your Project URL and anon/service_role API Key below:

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# Directory where generated PDF certificates are stored locally
CERTIFICATES_DIR=./generated_certificates
